# This is an empty file, please overwrite it after generating the .config file with the source code

CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_netgear_r6300-v2=y

CONFIG_LUCI=y
CONFIG_LUCI_LANG_zh-cn=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-ipmark=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y

# 不编译无关
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_upnp=n
CONFIG_PACKAGE_qosify=n
CONFIG_PACKAGE_vsftpd=n
